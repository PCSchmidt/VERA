# Corpus PDFs are evaluation data: store locally, never commit (CLAUDE.md data rules)
data/raw/
# Text and other derivatives of corpus papers: also never committed
data/cache/
# Benchmark items and the label-check sheet quote corpus tables and reference lists; the split
# (ids + test SHA-256) and label checks are committed, and scripts/build_benchmark.py rebuilds the items
data/benchmark/items.jsonl
data/benchmark/label_check_sheet.md

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Meridian runtime state (auto-generated, not for version control)
.meridian/memory/
.meridian/telemetry.jsonl
.meridian/session.json
.meridian/hooks.log
.meridian/drift/
.claude/hooks/.meridian/

# Run ledgers: only named result ledgers are committed (SPEC "Ledger and model-call wrapper")
data/ledger/*
!data/ledger/smoke.jsonl
!data/ledger/smoke_verdicts.jsonl
!data/ledger/bench_*.jsonl

.clinerules/
.cursor/
.windsurf/