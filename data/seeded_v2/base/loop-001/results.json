 "best": null,
 "ideas": [
  {
   "name": "C1: Importance-selected interaction list",
   "description": "Fit a cheap first TreeHFD with interaction_order=2 on a subsample of X_train. Rank pairs by the variance of their interaction components, and keep the top-k pairs (k about 2p). Refit with interaction_list set to these pairs. This drops negligible pairs, cutting runtime, and may lower the residual by reducing the numerical error from unused terms."
  },
  {
   "name": "C2: Residual-driven pair augmentation",
   "description": "Fit the baseline with a small interaction_list. Compute the residual of the model prediction minus the component sum on X_train. Score each candidate pair by how much a 2D binned mean of the residual (a function of only that pair's variables) reduces residual variance. Add the top pairs to interaction_list and refit. Repeat for 1-2 rounds."
  },
  {
   "name": "C3: Additive residual recalibration",
   "description": "After the TreeHFD fit, compute the training residual r = f(X) - sum of components. Fit 1D and 2D binned-mean smoothers of r (or shallow single-variable and single-pair boosted stumps) over the existing main and interaction variables. Add the fitted corrections to the matching components, so each stays a function of its own variables. Predict by adding the corrections on test data."
  }
 ]
