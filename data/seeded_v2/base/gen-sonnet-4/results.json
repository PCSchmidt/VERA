 "ideas": [
  {
   "name": "C1: Importance-ranked interaction selection",
   "description": "Fit a first TreeHFD pass with the default settings. Score each pair by the variance of its predicted interaction component on training data. Keep only the top-k pairs (k chosen by held-out residual) and pass them as interaction_list in a second fit. This lowers runtime by dropping negligible pairs, and fewer pairs may also reduce the residual."
  },
  {
   "name": "C2: Co-occurrence interaction list",
   "description": "Scan the xgboost trees and count how often each variable pair appears together on the same root-to-leaf path, weighted by gain or cover. Pass the pairs with the highest counts as interaction_list. This targets the interactions the model actually uses, so the residual from missed pairs falls and the runtime drops compared with using all pairs."
  },
  {
   "name": "C3: Residual additive refit",
   "description": "Take the TreeHFD components on training data and compute the residual between the model predictions and their sum. Fit a small ridge regression or a 1D/2D spline smoother of that residual for each component, using only that component's own variables. Add the fitted corrections to the components, which reduces the residual without breaking the variable-locality constraint."
  }
 ]
