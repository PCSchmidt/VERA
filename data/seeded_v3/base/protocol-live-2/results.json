 "best": null,
 "ideas": [
  {
   "name": "C1: Interaction screening by strength",
   "description": "Fit TreeHFD with main effects only (interaction_order=1) or a cheap run, rank variable pairs by the variance of their interaction components or by xgboost co-occurrence in tree paths, then refit with interaction_list restricted to the top-K pairs. This cuts runtime, and removing weak pairs reduces estimation noise in sparse regions. The restricted list must still be a valid set of pairs."
  },
  {
   "name": "C2: Residual backfitting refit",
   "description": "After the TreeHFD fit on training data, compute the residual between the model predictions and the component sum. Fit a per-component 1D or 2D smoother (a shallow gradient-boosted tree or spline on only that component's variables) to the residual and add it to that component. Repeat for 2-3 backfitting rounds, with each component using only its own variables. Evaluate on held-out data."
  },
  {
   "name": "C3: Depth-limited variable selection",
   "description": "Sweep depth_variable over a small grid, such as 2, 3, 4 and None, using a validation split. Choose the value with the lowest residual MSE, or the fastest value within tolerance of the best. Optionally combine the fits per component by non-negative least-squares weights on validation predictions, so that each component stays a function of its own variables."
  }
 ],
