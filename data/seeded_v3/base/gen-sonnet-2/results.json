 "best": null,
 "ideas": [
  {
   "name": "C1: Importance-selected interaction list",
   "description": "Fit TreeHFD once with a cheap setting to get interaction components, rank pairs by variance of their predicted contribution on training data, and keep the top-k pairs (e.g. those covering 95% of interaction variance). Refit with interaction_list set to these pairs, which cuts runtime and removes noisy components."
  },
  {
   "name": "C2: Co-occurrence pair selection",
   "description": "Parse the xgboost trees and count, weighted by split gain or cover, how often each variable pair appears together on the same root-to-leaf path. Pass the top-weighted pairs as interaction_list. Pairs that the model actually uses are covered, so residual from missing interactions drops, and unused pairs are skipped to save time."
  },
  {
   "name": "C3: Residual backfitting of components",
   "description": "After fitting TreeHFD, compute training residuals r = f(X) - sum of components. Fit a one-dimensional smoother (e.g. isotonic or binned means) of r on each variable, and a 2D binned smoother for each listed pair, in a few backfitting passes. Add the results to the corresponding components. Each stays a function of its own variables only, and the held-out residual shrinks."
  }
 ]
