 "best": null,
 "ideas": [
  {
   "name": "C1: Prune weak interactions",
   "description": "Fit TreeHFD with interaction_order=2, compute each interaction's variance on held-out predictions, then refit keeping only interactions above a variance threshold (interaction_list). Reassigning negligible interactions reduces residual MSE if small interactions mostly capture noise, and shrinks q for faster predict."
  },
  {
   "name": "C2: Vary depth_variable",
   "description": "Sweep depth_variable over several values (e.g., 2, 3, 4, None) on a validation split; pick the depth minimizing Residual MSE. The variable-selection depth controls which features enter each component, so a shallower or tuned depth may yield components that better explain the model's predictions."
  },
  {
   "name": "C3: Residual refit calibration",
   "description": "After TreeHFD's predict, compute the residual (model prediction minus summed components) on training data and fit a small correction: e.g., ridge regression of the residual on the components' own variables only, added back per component. This recalibrates each component while keeping it a function of its own variables, reducing residual MSE."
  }
 ],
