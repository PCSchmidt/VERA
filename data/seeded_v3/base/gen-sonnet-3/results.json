 "best": null,
 "ideas": [
  {
   "name": "C1: Importance-ranked interaction selection",
   "description": "Compute pair importance from the xgboost trees: sum gain over splits where a variable is split below an ancestor on another variable, per unordered pair. Pass the top-K pairs (K around 2p) as interaction_list to XGBTreeHFD. This reduces the number of fitted components, cutting runtime, and focuses the budget on the pairs that carry the model's real interactions."
  },
  {
   "name": "C2: Held-out component recalibration",
   "description": "Fit TreeHFD on the training data and compute the components on a held-out split of the training data. Fit a non-negative ridge regression of the model predictions on the intercept plus the component columns, then apply the per-component scale factors at test time. Each component is still a function of its own variables only, and the shrinkage corrects the systematic bias in the residual."
  },
  {
   "name": "C3: Residual-pair greedy refinement",
   "description": "Fit TreeHFD with main effects only, or with a small interaction list. Compute the residual of the model prediction on the training data. Score each candidate pair by how much variance a 2D binned-mean smoother on that pair explains in the residual. Add the top pairs to interaction_list and refit. Repeat once or twice. This targets the interactions that reduce the residual most."
  }
 ]
